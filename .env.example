# Atlassian Cloud API Configuration
# Create a scoped API token at:
# https://id.atlassian.com/manage-profile/security/api-tokens
ATLASSIAN_SITE_URL=https://your-site.atlassian.net
ATLASSIAN_EMAIL=you@example.com
ATLASSIAN_API_TOKEN=your-api-token-here

# Optional. Story point custom field id for sprint point rollups.
# Defaults to customfield_10105; find yours in the Jira field configuration.
ATLASSIAN_STORY_POINTS_FIELD=customfield_10105

# Optional. Default Jira project key, so `jira create` can omit --project.
ATLASSIAN_JIRA_PROJECT=DMP

# Optional. Default Jira board id, so board-scoped commands can omit it:
# `jira sprint current`, `jira sprint list`, and `jira sprint create`.
ATLASSIAN_JIRA_BOARD_ID=1234
